# Copy to .env and fill in. Never commit .env.

# Long random strings, for example: python3 -c "import secrets; print(secrets.token_hex(32))"
DJANGO_SECRET_KEY=change-me
POSTGRES_PASSWORD=change-me

# Login for the web UI, created once on first start. Used only with REQUIRE_LOGIN=true.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# The bundle-server to configure at startup. Add others on the Servers page.
BUNDLE_SERVER_NAME=storage
BUNDLE_SERVER_URL=http://storage.int.vanzantvoort.org:8080/api/v1
BUNDLE_SERVER_TOKEN=change-me

# Where the web UI listens on this host, and which host names it answers to.
BIND_ADDRESS=0.0.0.0
PORT=6060
DJANGO_ALLOWED_HOSTS=*

# false: anyone who can reach the port can use the UI, with no login.
# true:  require the ADMIN_USERNAME login below.
REQUIRE_LOGIN=false

# Only behind an HTTPS proxy:
# DJANGO_CSRF_TRUSTED_ORIGINS=https://bundles.example.org
# DJANGO_SECURE_COOKIES=true

TIME_ZONE=UTC

# Seconds between full background syncs.
BUNDLE_SYNC_INTERVAL=900
